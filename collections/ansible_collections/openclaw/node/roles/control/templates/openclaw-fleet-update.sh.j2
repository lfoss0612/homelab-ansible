#!/usr/bin/env bash
# Managed by Ansible — openclaw.node.control role. Do not edit on the host;
# change the role and re-run playbooks/openclaw-automation.yml.
#
# Replaces scripts/openclaw-sync.sh. That script's ordering bug is the whole
# reason this one exists: it rewrote openclaw_version in group_vars *before*
# running the rollout, so when the rollout died (2026-06-04, an interactive
# corepack prompt with no stdin, killed after 7m30s) the recorded version
# already matched the gateway. Five minutes later the next poll compared the
# two, saw them agree, and logged "Versions match. Nothing to do." The failure
# erased its own evidence and the fleet sat un-upgraded for two months.
#
# So, two rules here:
#   * The pin is only ever READ. It is set by a human commit. Nothing on this
#     host writes a tracked file — no sed, no version discovery from the
#     gateway.
#   * Recorded state is written only after every playbook has exited 0.
#     `set -e` plus the ordering below is what enforces that; there is no
#     success path that skips a failure.
#
# Failure surfaces as a failed systemd unit and a journal trace. Check with
#   systemctl status {{ openclaw_control_unit }}.service
#   journalctl -u {{ openclaw_control_unit }}.service -n 200

set -euo pipefail

ANSIBLE_DIR={{ openclaw_control_dir }}
STATE_DIR={{ openclaw_control_state_dir }}
LOCK_FILE="$STATE_DIR/.lock"
SUCCESS_FILE="$STATE_DIR/last-success"

# Belt and braces against the documented gotcha: ansible.cfg is only picked up
# from the current directory, and a run that misses it silently uses the wrong
# inventory and the wrong collections path rather than erroring.
export ANSIBLE_CONFIG="$ANSIBLE_DIR/ansible.cfg"

log() { printf '[%s] %s\n' "$(date -Iseconds)" "$*"; }

mkdir -p "$STATE_DIR"

# A manual run and a timer firing must never overlap: update-openclaw.yml is
# serialized with health gates, and two of them interleaved would gate on each
# other's restarts.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "another {{ openclaw_control_unit }} run holds the lock — exiting without doing anything"
  exit 0
fi

cd "$ANSIBLE_DIR"

before=$(git rev-parse HEAD)
log "pulling $ANSIBLE_DIR (currently ${before:0:7})"
git pull --ff-only
after=$(git rev-parse HEAD)

if [ "$before" = "$after" ]; then
  log "checkout unchanged at ${after:0:7}"
else
  log "checkout advanced ${before:0:7} -> ${after:0:7}"
fi

# Read-only, for the log line and the state file. See the header: this value
# is never written back.
pin=$(sed -n 's/^openclaw_version:[[:space:]]*"\?\([^"]*\)"\?.*/\1/p' \
  group_vars/openclaw.yml | head -1)
log "pinned openclaw_version: ${pin:-unknown}"

# --- Per-host convergence capture -------------------------------------------
# Every playbook's output is teed here so the PLAY RECAP blocks can be parsed
# into a per-host status file that the notify script pushes to Zabbix. `tee`
# is safe under `set -o pipefail` above: a failing playbook still fails the
# pipeline, so none of this weakens the "recorded state only after every
# playbook exits 0" rule in the header.
RAW_FILE="$STATE_DIR/.last-run-output"
HOSTS_FILE="$STATE_DIR/last-hosts"
: > "$RAW_FILE"

# Worst-case status per host across every recap seen this run:
#   0 = converged clean   1 = task failures   2 = unreachable
# 1 outranks 2 outranks 0, and a later clean recap never downgrades an earlier
# problem. Unreachable is kept distinct from failed on purpose: openclaw_optional
# hosts (desktop) are legitimately powered off, and collapsing that into "failed"
# would make the fleet go red every time someone shuts their desktop down — the
# exact noise the optional-host split in the playbooks exists to avoid.
summarize_hosts() {
  awk '
    /^[^ ]+ *: *ok=/ {
      host = $1
      failed = 0; unreach = 0
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^failed=/)      { split($i, a, "="); failed  += a[2] }
        if ($i ~ /^unreachable=/) { split($i, a, "="); unreach += a[2] }
      }
      if (host == "localhost") next          # no Zabbix host by that name
      if (failed > 0)                          status[host] = 1
      else if (unreach > 0 && status[host] != 1) status[host] = 2
      else if (!(host in status))              status[host] = 0
    }
    END { for (h in status) printf "%s %s\n", h, status[h] }
  ' "$RAW_FILE" > "$HOSTS_FILE" 2>/dev/null || :
}

# An EXIT trap, not a call after the loop: `set -e` means a failing playbook
# never reaches the end of this script, and a failed run is precisely when the
# per-host breakdown is worth having. Registered after the lock check so the
# "another run holds the lock" exit cannot blank the file.
trap summarize_hosts EXIT

{% for playbook in openclaw_control_playbooks %}
log "running {{ playbook }}"
ansible-playbook {{ playbook }} 2>&1 | tee -a "$RAW_FILE"

{% endfor %}
printf 'timestamp=%s\ncommit=%s\nopenclaw_version=%s\n' \
  "$(date -Iseconds)" "$after" "${pin:-unknown}" > "$SUCCESS_FILE"

log "fleet converged and validated at ${after:0:7}; recorded $SUCCESS_FILE"
